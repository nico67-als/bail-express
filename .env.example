# =============================================================================
# BAIL EXPRESS — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Ne jamais committer .env.local sur Git
# =============================================================================

# --- STRIPE ---
# Tableau de bord : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs des produits Stripe (créés dans le dashboard)
STRIPE_PRICE_ID_MEUBLE=price_...
STRIPE_PRICE_ID_VIDE=price_...

# --- RESEND (emails) ---
# Tableau de bord : https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@bail-express.fr
RESEND_REPLY_TO_EMAIL=contact@bail-express.fr

# --- STOCKAGE PDF ---
# Vercel Blob (configuré automatiquement sur Vercel)
BLOB_READ_WRITE_TOKEN=vercel_blob_...

# --- APPLICATION ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
